{
  "name": "hkp-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "End-to-end suite driving the HKP webapp across its host profiles (web, Readymade desktop, mobile).",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:web": "playwright test --project=web",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:cloud": "playwright test --config=playwright.cloud.config.ts",
    "report": "playwright show-report",
    "test:reporter": "node --experimental-strip-types --test support/tests/summary-reporter.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.12.2",
    "typescript": "^5.2.2"
  }
}
