{
  "name": "@readymadeit/mcp",
  "version": "0.2.0",
  "description": "Read-only MCP knowledge server for Readymade documentation, boards, contracts, and service sources.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "readymade-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "bundle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && npm run bundle",
    "runInspector": "npx @modelcontextprotocol/inspector@latest"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://readymadeit.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbastuck/readymade.git",
    "directory": "readymade-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.6.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
