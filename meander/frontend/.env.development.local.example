# Settings for `npm run dev` on this machine. Copy to .env.development.local
# (not committed), which Vite reads in development.

# Where the links a board's owner copies for its members point. Unset, they
# point at https://readymadeit.com — set it to a website you run locally to
# open those links against it.
VITE_MEMBER_WEBAPP_ORIGIN=http://localhost:4000
