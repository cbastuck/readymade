                        {
                          "serviceId": "sub-service",
                          "instanceId": "beat-2",
                          "serviceName": "Beat",
                          "state": {
                            "scope": {
                              "slots": "inherit"
                            },
                            "pipeline": [
                              {
                                "serviceId": "hookup.to/service/sound",
                                "instanceId": "hihat-1",
                                "serviceName": "Hi-hat",
                                "state": {
                                  "generator": "drums",
                                  "trigger": "hihat",
                                  "volume": 0.5
                                }
                              },
                              {
                                "serviceId": "hookup.to/service/timer",
                                "instanceId": "eighth-1",
                                "serviceName": "Wait an eighth",
                                "state": {
