                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "facade": {
    "layout": "single",
    "panels": [
      {
        "id": "main",
        "title": "Nested Rhythm",
        "layout": {
          "direction": "column",
          "gap": 12,
          "paddingX": 16,
          "paddingY": 12,
          "items": [
            {
              "type": "text",
              "placeholder": "Hi-hats live in the innermost Beat, the snare one level up between two Beats, the kick at the top of the Bar. Every wait is in beats; the tempo is one slot in the outermost scope, and every scope inside inherits it.",
              "tone": "muted",
              "fontSize": 12
            },
            {
              "direction": "row",
              "gap": 16,
              "align": "center",
              "items": [
                {
                  "type": "knob",
                  "label": "Tempo",
                  "unit": "BPM",
                  "min": 60,
                  "max": 180,
                  "defaultValue": 120,
                  "action": {
                    "serviceUuid": "groove.tempo",
                    "configure": {
                      "value": "{{value}}"
                    }
                  }
                },
                {
                  "direction": "column",
                  "gap": 10,
                  "items": [
                    {
                      "direction": "row",
                      "gap": 10,
                      "align": "center",
                      "items": [
                        {
                          "type": "button",
                          "label": "Play",
                          "actions": [
                            {
                              "type": "configure",
                              "serviceUuid": "groove.clock",
                              "configure": {
                                "start": true,
                                "immediate": true
                              }
                            }
                          ]
                        },
                        {
                          "type": "button",
                          "label": "Stop",
                          "actions": [
                            {
                              "type": "configure",
                              "serviceUuid": "groove.clock",
                              "configure": {
                                "stop": true
                              }
                            },
                            {
                              "type": "configure",
                              "serviceUuid": "groove",
                              "configure": {
                                "cancel": true
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "label": "Bars",
                      "source": {
                        "serviceUuid": "groove.clock",
                        "path": "counter"
                      },
                      "placeholder": "0"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
