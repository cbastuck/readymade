{
  "boardName": "Nested Rhythm",
  "description": "A drum groove built from nested sub-services, where a pipeline's length in time is the sum of the waits inside it.\n\nFour patterns — Straight, Shuffle, Four on the floor and Funk — each a **Bar** made of smaller blocks: a Beat of two hi-hats, Two beats with a snare between them, and so on. The Shuffle is the Straight bar with a swung Beat; the Funk pushes kicks onto the \"and\" with a block that is sixteenth hi-hats with a kick in the middle.\n\nEvery wait is measured in beats. The tempo and the chosen pattern are slots in the outermost scope, the **Groove**. Each bar reads the pattern and a Switch routes the bar into it; every scope inside inherits the Groove's slots, so a Beat reads the tempo from its surroundings without knowing where it is set.",
  "runtimes": [
    {
      "id": "ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "ui": [
      {
        "uuid": "groove",
        "serviceId": "sub-service",
        "serviceName": "Groove",
        "state": {
          "stopPropagation": true,
          "scope": {
            "slots": "own"
          },
          "pipeline": [
            {
              "serviceId": "hookup.to/service/hold",
              "instanceId": "tempo",
              "serviceName": "Tempo",
              "state": {
                "slot": "tempo",
                "op": "write",
                "value": 120
              }
            },
            {
              "serviceId": "hookup.to/service/hold",
              "instanceId": "pattern",
              "serviceName": "Pattern",
              "state": {
                "slot": "pattern",
                "op": "write",
                "value": "straight"
              }
            },
            {
              "serviceId": "hookup.to/service/timer",
              "instanceId": "clock",
              "serviceName": "One bar",
              "state": {
                "periodic": true,
                "periodicValue": 4,
                "periodicUnit": "beats"
              }
            },
            {
              "serviceId": "hookup.to/service/hold",
              "instanceId": "which",
              "serviceName": "Which pattern",
              "state": {
                "slot": "pattern",
                "op": "read"
              }
            },
            {
              "serviceId": "hookup.to/service/switch",
              "instanceId": "patterns",
              "serviceName": "Patterns",
              "state": {
                "cases": [
                  {
                    "when": "params == 'straight'",
                    "pipeline": [
                      {
                        "serviceId": "sub-service",
                        "instanceId": "straight",
                        "serviceName": "Straight",
                        "state": {
                          "scope": {
                            "slots": "inherit"
                          },
                          "pipeline": [
                            {
                              "block": "hit",
                              "serviceName": "Kick",
                              "params": {
                                "trigger": "kick",
                                "volume": 0.9
                              }
                            },
                            {
                              "block": "two-beats",
                              "instanceId": "half-1",
                              "params": {
                                "beat": "beat"
                              }
                            },
                            {
                              "block": "two-beats",
                              "instanceId": "half-2",
                              "params": {
                                "beat": "beat"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "when": "params == 'shuffle'",
                    "pipeline": [
                      {
                        "serviceId": "sub-service",
                        "instanceId": "shuffle",
                        "serviceName": "Shuffle",
                        "state": {
                          "scope": {
                            "slots": "inherit"
                          },
                          "pipeline": [
                            {
                              "block": "hit",
                              "serviceName": "Kick",
                              "params": {
                                "trigger": "kick",
                                "volume": 0.9
                              }
                            },
                            {
                              "block": "two-beats",
                              "instanceId": "half-1",
                              "params": {
                                "beat": "swung-beat"
                              }
                            },
                            {
                              "block": "hit",
                              "serviceName": "Kick",
                              "params": {
                                "trigger": "kick",
                                "volume": 0.8
                              }
                            },
                            {
                              "block": "two-beats",
                              "instanceId": "half-2",
                              "params": {
                                "beat": "swung-beat"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "when": "params == 'four-on-the-floor'",
                    "pipeline": [
                      {
                        "serviceId": "sub-service",
                        "instanceId": "four-on-the-floor",
                        "serviceName": "Four on the floor",
                        "state": {
                          "scope": {
                            "slots": "inherit"
                          },
                          "pipeline": [
                            {
                              "block": "two-beats",
                              "instanceId": "half-1",
                              "params": {
                                "beat": "floor-beat",
                                "snare": 0.6
                              }
                            },
                            {
                              "block": "two-beats",
                              "instanceId": "half-2",
                              "params": {
                                "beat": "floor-beat",
                                "snare": 0.6
                              }
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "when": "params == 'funk'",
                    "pipeline": [
                      {
                        "serviceId": "sub-service",
                        "instanceId": "funk",
                        "serviceName": "Funk",
                        "state": {
                          "scope": {
                            "slots": "inherit"
                          },
                          "pipeline": [
                            {
                              "serviceId": "sub-service",
                              "instanceId": "half-1",
                              "serviceName": "First half",
                              "state": {
                                "scope": {
                                  "slots": "inherit"
                                },
                                "pipeline": [
                                  {
                                    "block": "hit",
                                    "serviceName": "Kick",
                                    "params": {
                                      "trigger": "kick",
                                      "volume": 0.9
                                    }
                                  },
                                  {
                                    "block": "sixteenths",
                                    "instanceId": "beat-1"
                                  },
                                  {
                                    "block": "hit",
                                    "serviceName": "Snare",
                                    "params": {
                                      "trigger": "snare",
                                      "volume": 0.7
                                    }
                                  },
                                  {
                                    "block": "kick-on-the-and",
                                    "instanceId": "beat-2"
                                  }
                                ]
                              }
                            },
                            {
                              "serviceId": "sub-service",
                              "instanceId": "half-2",
                              "serviceName": "Second half",
                              "state": {
                                "scope": {
                                  "slots": "inherit"
                                },
                                "pipeline": [
                                  {
                                    "block": "kick-on-the-and",
                                    "instanceId": "beat-1"
                                  },
                                  {
                                    "block": "hit",
                                    "serviceName": "Snare",
                                    "params": {
                                      "trigger": "snare",
                                      "volume": 0.7
                                    }
                                  },
                                  {
                                    "block": "sixteenths",
                                    "instanceId": "beat-2"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                ],
                "default": []
              }
            }
          ]
        }
      }
    ]
  },
  "blocks": [
    {
      "id": "hit",
      "name": "Hit",
      "serviceId": "hookup.to/service/sound",
      "description": "One drum sound, played the moment it is reached. Takes no time, so it sounds together with whatever follows it.",
      "params": {
        "trigger": "kick",
        "volume": 0.8
      },
      "state": {
        "generator": "drums",
        "trigger": "{{param.trigger}}",
        "volume": "{{param.volume}}"
      }
    },
    {
      "id": "note",
      "name": "Note",
      "serviceId": "sub-service",
      "description": "A hit, then a wait: the sound and how long it lasts, in beats, before the next thing plays.",
      "params": {
        "trigger": "hihat",
        "volume": 0.5,
        "beats": 0.5
      },
      "state": {
        "scope": {
          "slots": "inherit"
        },
        "pipeline": [
          {
            "block": "hit",
            "instanceId": "hit",
            "params": {
              "trigger": "{{param.trigger}}",
              "volume": "{{param.volume}}"
            }
          },
          {
            "serviceId": "hookup.to/service/timer",
            "instanceId": "wait",
            "serviceName": "Wait",
            "state": {
              "periodic": false,
              "oneShotDelay": "{{param.beats}}",
              "oneShotDelayUnit": "beats"
            }
          }
        ]
      }
    },
    {
      "id": "beat",
      "name": "Beat",
      "serviceId": "sub-service",
      "description": "One beat as two eighth-note hi-hats, the first accented.",
      "state": {
        "scope": {
          "slots": "inherit"
        },
        "pipeline": [
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.5,
              "beats": 0.5
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.35,
              "beats": 0.5
            }
          }
        ]
      }
    },
    {
      "id": "floor-beat",
      "name": "Kick beat",
      "serviceId": "sub-service",
      "description": "One beat as a kick on the beat and a hi-hat on the off-beat.",
      "state": {
        "scope": {
          "slots": "inherit"
        },
        "pipeline": [
          {
            "block": "note",
            "params": {
              "trigger": "kick",
              "volume": 0.9,
              "beats": 0.5
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.45,
              "beats": 0.5
            }
          }
        ]
      }
    },
    {
      "id": "swung-beat",
      "name": "Swung beat",
      "serviceId": "sub-service",
      "description": "One beat as two hi-hats split two thirds to one third: the eighths of a shuffle.",
      "state": {
        "scope": {
          "slots": "inherit"
        },
        "pipeline": [
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.5,
              "beats": 0.6667
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.3,
              "beats": 0.3333
            }
          }
        ]
      }
    },
    {
      "id": "sixteenths",
      "name": "Sixteenths",
      "serviceId": "sub-service",
      "description": "One beat as four sixteenth-note hi-hats.",
      "state": {
        "scope": {
          "slots": "inherit"
        },
        "pipeline": [
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.45,
              "beats": 0.25
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.2,
              "beats": 0.25
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.3,
              "beats": 0.25
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.2,
              "beats": 0.25
            }
          }
        ]
      }
    },
    {
      "id": "kick-on-the-and",
      "name": "Kick on the and",
      "serviceId": "sub-service",
      "description": "Sixteenths with a kick on the \"and\" — the off-beat in the middle of the beat.",
      "state": {
        "scope": {
          "slots": "inherit"
        },
        "pipeline": [
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.45,
              "beats": 0.25
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.2,
              "beats": 0.25
            }
          },
          {
            "block": "hit",
            "serviceName": "Kick",
            "params": {
              "trigger": "kick",
              "volume": 0.8
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.3,
              "beats": 0.25
            }
          },
          {
            "block": "note",
            "params": {
              "trigger": "hihat",
              "volume": 0.2,
              "beats": 0.25
            }
          }
        ]
      }
    },
    {
      "id": "two-beats",
      "name": "Two beats",
      "serviceId": "sub-service",
      "description": "Half a bar: a beat, a snare on the backbeat, and the beat again. Which beat is a parameter.",
      "params": {
        "beat": "beat",
        "snare": 0.7
      },
      "state": {
        "scope": {
          "slots": "inherit"
        },
        "pipeline": [
          {
            "block": "{{param.beat}}",
            "instanceId": "beat-1"
          },
          {
            "block": "hit",
            "instanceId": "snare",
            "serviceName": "Snare",
            "params": {
              "trigger": "snare",
              "volume": "{{param.snare}}"
            }
          },
          {
            "block": "{{param.beat}}",
            "instanceId": "beat-2"
          }
        ]
      }
    }
  ],
  "facade": {
    "layout": "single",
    "panels": [
      {
        "id": "main",
        "title": "Nested Rhythm",
        "layout": {
          "direction": "column",
          "gap": 12,
          "paddingX": 16,
          "paddingY": 12,
          "items": [
            {
              "type": "text",
              "placeholder": "Each pattern is a bar built from smaller blocks nested inside it. Every wait is in beats; the tempo and the pattern are slots in the outermost scope, and a pattern change lands on the next bar.",
              "tone": "muted",
              "fontSize": 12
            },
            {
              "direction": "row",
              "gap": 16,
              "align": "center",
              "items": [
                {
                  "type": "knob",
                  "label": "Tempo",
                  "unit": "BPM",
                  "min": 60,
                  "max": 180,
                  "defaultValue": 120,
                  "action": {
                    "serviceUuid": "groove.tempo",
                    "configure": {
                      "value": "{{value}}"
                    }
                  }
                },
                {
                  "direction": "column",
                  "gap": 10,
                  "items": [
                    {
                      "direction": "row",
                      "gap": 10,
                      "align": "center",
                      "items": [
                        {
                          "type": "button",
                          "label": "Play",
                          "actions": [
                            {
                              "type": "configure",
                              "serviceUuid": "groove.clock",
                              "configure": {
                                "start": true,
                                "immediate": true
                              }
                            }
                          ]
                        },
                        {
                          "type": "button",
                          "label": "Stop",
                          "actions": [
                            {
                              "type": "configure",
                              "serviceUuid": "groove.clock",
                              "configure": {
                                "stop": true
                              }
                            },
                            {
                              "type": "configure",
                              "serviceUuid": "groove",
                              "configure": {
                                "cancel": true
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "direction": "row",
                      "gap": 8,
                      "align": "center",
                      "items": [
                        {
                          "type": "button",
                          "label": "Straight",
                          "actions": [
                            {
                              "type": "configure",
                              "serviceUuid": "groove.pattern",
                              "configure": {
                                "value": "straight"
                              }
                            }
                          ]
                        },
                        {
                          "type": "button",
                          "label": "Shuffle",
                          "actions": [
                            {
                              "type": "configure",
                              "serviceUuid": "groove.pattern",
                              "configure": {
                                "value": "shuffle"
                              }
                            }
                          ]
                        },
                        {
                          "type": "button",
                          "label": "Four on the floor",
                          "actions": [
                            {
                              "type": "configure",
                              "serviceUuid": "groove.pattern",
                              "configure": {
                                "value": "four-on-the-floor"
                              }
                            }
                          ]
                        },
                        {
                          "type": "button",
                          "label": "Funk",
                          "actions": [
                            {
                              "type": "configure",
                              "serviceUuid": "groove.pattern",
                              "configure": {
                                "value": "funk"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "direction": "row",
                      "gap": 16,
                      "align": "center",
                      "items": [
                        {
                          "type": "text",
                          "label": "Pattern",
                          "source": {
                            "serviceUuid": "groove.pattern",
                            "path": "held"
                          },
                          "placeholder": "straight"
                        },
                        {
                          "type": "text",
                          "label": "Bars",
                          "source": {
                            "serviceUuid": "groove.clock",
                            "path": "counter"
                          },
                          "placeholder": "0"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
