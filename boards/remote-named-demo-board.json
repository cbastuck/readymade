{
  "boardName": "Remote by name",
  "description": "A runtime that names its runtime server instead of giving an address: \"remote\": \"node\" is looked up among the runtime servers this client keeps. A Timer on that server ticks into a Monitor there and one in the browser.",
  "runtimes": [
    {
      "id": "remote-test-node",
      "name": "Node",
      "type": "rest",
      "remote": "node",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "remote-test-ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "remote-test-node": [
      {
        "uuid": "remote-test-timer",
        "serviceId": "timer",
        "serviceName": "Timer",
        "state": {
          "periodic": true,
          "periodicValue": 2,
          "periodicUnit": "s",
          "running": true
        }
      },
      {
        "uuid": "remote-test-stamp",
        "serviceId": "map",
        "serviceName": "Stamp",
        "state": {
          "mode": "add",
          "template": {
            "from": "the node runtime"
          }
        }
      },
      {
        "uuid": "remote-test-node-monitor",
        "serviceId": "monitor",
        "serviceName": "On the server"
      }
    ],
    "remote-test-ui": [
      {
        "uuid": "remote-test-ui-monitor",
        "serviceId": "hookup.to/service/monitor",
        "serviceName": "In the browser"
      }
    ]
  }
}