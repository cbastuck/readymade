{
  "boardName": "MLP Demo",
  "description": "The other half of a GPT-2 layer: after layer 0's attention has moved information between tokens, its MLP works on each token alone and adds what it computed to the stream. The MLP's panel shows each token's vector size after it, and the size of what it added. Change its layer, or remove the attention before it, and inject again. Fetches GPT-2 small (548 MB) once. Needs the hkp-python kept under the name \"python\", with the transformer extra (uv sync --extra transformer).",
  "assets": [
    {
      "id": "gpt2-weights",
      "name": "GPT-2 small (124M)",
      "mediaType": "application/octet-stream",
      "url": "https://huggingface.co/openai-community/gpt2/resolve/main/model.safetensors",
      "sha256": "248dfc3911869ec493c76e65bf2fcf7f615828b0254c12b473182f0f81d3a707",
      "size": 548105171,
      "runtimes": [
        "python"
      ]
    },
    {
      "id": "gpt2-tokenizer",
      "name": "GPT-2 tokenizer",
      "mediaType": "application/json",
      "url": "https://huggingface.co/openai-community/gpt2/resolve/main/tokenizer.json",
      "runtimes": [
        "python"
      ]
    },
    {
      "id": "gpt2-config",
      "name": "GPT-2 configuration",
      "mediaType": "application/json",
      "url": "https://huggingface.co/openai-community/gpt2/resolve/main/config.json",
      "runtimes": [
        "python"
      ]
    }
  ],
  "runtimes": [
    {
      "id": "ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "python",
      "name": "hkp-python",
      "type": "rest",
      "remote": "python",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "out",
      "name": "Result",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "ui": [
      {
        "uuid": "input",
        "serviceId": "hookup.to/service/injector",
        "serviceName": "Input",
        "state": {
          "recentInjection": "The colours of the rainbow are red, orange,",
          "plainText": true
        }
      }
    ],
    "python": [
      {
        "uuid": "tokenize",
        "serviceId": "tokenize",
        "serviceName": "Tokenize",
        "state": {
          "tokenizer": "hkp-asset://gpt2-tokenizer",
          "addSpecial": true
        }
      },
      {
        "uuid": "embed",
        "serviceId": "token-embed",
        "serviceName": "Token embed",
        "state": {
          "model": "hkp-asset://gpt2-weights",
          "config": "hkp-asset://gpt2-config"
        }
      },
      {
        "uuid": "attention-0",
        "serviceId": "attention",
        "serviceName": "Attention, layer 0",
        "state": {
          "model": "hkp-asset://gpt2-weights",
          "config": "hkp-asset://gpt2-config",
          "layer": 0
        }
      },
      {
        "uuid": "mlp-0",
        "serviceId": "mlp",
        "serviceName": "MLP, layer 0",
        "state": {
          "model": "hkp-asset://gpt2-weights",
          "config": "hkp-asset://gpt2-config",
          "layer": 0
        }
      }
    ],
    "out": [
      {
        "uuid": "result",
        "serviceId": "hookup.to/service/monitor",
        "serviceName": "What comes out"
      }
    ]
  }
}
