{
  "boardName": "Face Alert",
  "description": "Watches the camera and sends a push notification through ntfy when a face appears. Detect reports faces on every frame; Changes turns 'a face is there' into 'a face appeared'; Debounce keeps a face that flickers in and out from sending several. Set the ntfy topic on the notification block's bar and subscribe to it in the ntfy app.",
  "facade": {
    "layout": "single",
    "panels": [
      {
        "id": "main",
        "layout": {
          "direction": "column",
          "gap": 12,
          "align": "center",
          "padding": 14,
          "items": [
            {
              "type": "camera",
              "serviceUuid": "camera-svc",
              "width": 320,
              "height": 240,
              "preview": false
            },
            {
              "type": "detect",
              "serviceUuid": "detect-svc",
              "width": 320
            },
            {
              "type": "text",
              "label": "Faces in view:",
              "source": {
                "serviceUuid": "detect-svc",
                "path": "count"
              },
              "placeholder": "waiting for the camera…"
            },
            {
              "type": "text",
              "placeholder": "A notification is sent when a face appears, at most once every 30 seconds. Set the ntfy topic on the notification block in the board view."
            }
          ]
        }
      }
    ]
  },
  "runtimes": [
    {
      "id": "ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "ui": [
      {
        "uuid": "timer-svc",
        "serviceId": "hookup.to/service/timer",
        "serviceName": "Every half second",
        "state": {
          "periodic": true,
          "periodicValue": 500,
          "periodicUnit": "ms",
          "running": true,
          "start": true,
          "immediate": true
        }
      },
      {
        "uuid": "camera-svc",
        "serviceId": "hookup.to/service/camera",
        "serviceName": "Camera",
        "state": {
          "captureFormat": "image/jpeg"
        }
      },
      {
        "uuid": "detect-svc",
        "serviceId": "hookup.to/service/detect",
        "serviceName": "Find faces",
        "state": {
          "mode": "face",
          "minConfidence": 0.6
        }
      },
      {
        "uuid": "appeared-svc",
        "serviceId": "hookup.to/service/changes",
        "serviceName": "A face appeared",
        "state": {
          "value": "params.count > 0",
          "emit": "rise"
        }
      },
      {
        "uuid": "cooldown-svc",
        "serviceId": "hookup.to/service/debounce",
        "serviceName": "At most every 30 s",
        "state": {
          "cooldown": 30
        }
      },
      {
        "uuid": "message-svc",
        "serviceId": "hookup.to/service/map",
        "serviceName": "Message",
        "state": {
          "mode": "replace",
          "template": {
            "message=": "params.count == 1 ? 'Someone is in front of the camera' : concat(string(params.count), ' people are in front of the camera')"
          }
        }
      },
      {
        "block": "ntfy-notification",
        "uuid": "notify",
        "params": {
          "topic": "readymade-face-alert",
          "title": "Face Alert",
          "priority": "high",
          "tags": "bust_in_silhouette"
        }
      },
      {
        "uuid": "sent-svc",
        "serviceId": "hookup.to/service/monitor",
        "serviceName": "Sent"
      }
    ]
  },
  "blocks": [
    {
      "id": "ntfy-notification",
      "name": "ntfy notification",
      "serviceId": "sub-service",
      "version": 1,
      "description": "Sends a push notification through ntfy. The message is the input's `message` field, or the input itself when it is a string; it is POSTed to <server>/<topic> with the title, priority and tags as headers, and ntfy's reply is passed on. Anyone who knows a topic on ntfy.sh can read it, so pick one that is hard to guess and subscribe to it in the ntfy app.",
      "homepage": "https://docs.ntfy.sh/publish/",
      "tags": [
        "Messaging"
      ],
      "runtimes": [
        "browser"
      ],
      "params": {
        "topic": "readymade-notifications",
        "title": "Readymade",
        "priority": "default",
        "tags": "",
        "server": "https://ntfy.sh"
      },
      "state": {
        "pipeline": [
          {
            "serviceId": "hookup.to/service/map",
            "instanceId": "build-request",
            "serviceName": "Build request",
            "state": {
              "mode": "replace",
              "template": {
                "config.serviceId": "hookup.to/service/fetcher",
                "config.data.method": "POST",
                "config.data.url": "{{param.server}}/{{param.topic}}",
                "config.data.headers.Title": "{{param.title}}",
                "config.data.headers.Priority": "{{param.priority}}",
                "config.data.headers.Tags": "{{param.tags}}",
                "config.data.body=": "params.message || params"
              }
            }
          },
          {
            "serviceId": "hookup.to/service/fetcher",
            "instanceId": "post",
            "serviceName": "POST to ntfy",
            "state": {}
          }
        ]
      }
    }
  ]
}
