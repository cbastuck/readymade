{
  "boardName": "State Demo",
  "runtimes": [
    { "id": "ui", "name": "Browser", "type": "browser", "state": { "wrapServices": false } }
  ],
  "services": {
    "ui": [
      {
        "uuid": "timer-svc",
        "serviceId": "hookup.to/service/timer",
        "serviceName": "Timer",
        "state": { "periodic": true, "periodicValue": 33, "periodicUnit": "ms", "running": true, "start": true, "immediate": true }
      },
      {
        "uuid": "position-svc",
        "serviceId": "hookup.to/service/map",
        "serviceName": "Position",
        "state": {
          "mode": "replace",
          "template": [
            {
              "type": "macro:ball",
              "x=": "round(sin(params.triggerCount * 0.05) * 220 + 300)",
              "y=": "round(sin(params.triggerCount * 0.037 + 1) * 120 + 200)"
            },
            {
              "type": "macro:ring",
              "x=": "round(sin(params.triggerCount * 0.05) * 220 + 300)",
              "y=": "round(sin(params.triggerCount * 0.037 + 1) * 120 + 200)"
            }
          ]
        }
      },
      {
        "uuid": "state-svc",
        "serviceId": "hookup.to/service/state",
        "serviceName": "State",
        "state": {
          "macros": {
            "ball": {
              "variables": ["x", "y"],
              "template": { "type": "circle", "x": "$value", "y": "$value", "radius": 18, "color": "#6366f1" }
            },
            "ring": {
              "variables": ["x", "y"],
              "template": {
                "type": "circle",
                "x": "$value",
                "y": "$value",
                "radius": 36,
                "contour": { "color": "#a5b4fc", "lineWidth": 4 }
              }
            }
          }
        }
      },
      {
        "uuid": "canvas-svc",
        "serviceId": "hookup.to/service/canvas",
        "serviceName": "Canvas",
        "state": { "clearOnRedraw": true, "resizable": true, "size": [600, 400] }
      }
    ]
  }
}
