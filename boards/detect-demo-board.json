{
  "boardName": "Detect Demo",
  "runtimes": [
    {
      "id": "ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "ui": [
      {
        "uuid": "timer-svc",
        "serviceId": "hookup.to/service/timer",
        "serviceName": "Every half second",
        "state": {
          "periodic": true,
          "periodicValue": 500,
          "periodicUnit": "ms",
          "running": true,
          "start": true,
          "immediate": true
        }
      },
      {
        "uuid": "camera-svc",
        "serviceId": "hookup.to/service/camera",
        "serviceName": "Camera",
        "state": {
          "captureFormat": "image/jpeg"
        }
      },
      {
        "uuid": "detect-svc",
        "serviceId": "hookup.to/service/detect",
        "serviceName": "Detect",
        "state": {
          "mode": "face",
          "minConfidence": 0.5
        }
      },
      {
        "uuid": "summary-svc",
        "serviceId": "hookup.to/service/map",
        "serviceName": "Summary",
        "state": {
          "mode": "replace",
          "template": {
            "count=": "params.count",
            "faces=": "params.faces"
          }
        }
      },
      {
        "uuid": "monitor-svc",
        "serviceId": "hookup.to/service/monitor",
        "serviceName": "Faces"
      }
    ]
  }
}
