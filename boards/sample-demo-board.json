{
  "boardName": "Sample Demo",
  "description": "From scores to one token. GPT-2 small runs its twelve layers once over the prompt, and a chain of Sample services chooses the next token: top-k keeps the 40 most likely, temperature sharpens what is left, pick draws one by probability. Each sampler's panel shows how many candidates are left and the most likely of them; the Monitor shows the tokens with the chosen one appended and the text it makes. Reorder the samplers, or set Pick one's mode to greedy, and inject again. Fetches GPT-2 small (548 MB) once. Needs the hkp-python kept under the name \"python\", with the transformer extra (uv sync --extra transformer).",
  "assets": [
    {
      "id": "gpt2-weights",
      "name": "GPT-2 small (124M)",
      "mediaType": "application/octet-stream",
      "url": "https://huggingface.co/openai-community/gpt2/resolve/main/model.safetensors",
      "sha256": "248dfc3911869ec493c76e65bf2fcf7f615828b0254c12b473182f0f81d3a707",
      "size": 548105171,
      "runtimes": [
        "python"
      ]
    },
    {
      "id": "gpt2-tokenizer",
      "name": "GPT-2 tokenizer",
      "mediaType": "application/json",
      "url": "https://huggingface.co/openai-community/gpt2/resolve/main/tokenizer.json",
      "runtimes": [
        "python"
      ]
    },
    {
      "id": "gpt2-config",
      "name": "GPT-2 configuration",
      "mediaType": "application/json",
      "url": "https://huggingface.co/openai-community/gpt2/resolve/main/config.json",
      "runtimes": [
        "python"
      ]
    }
  ],
  "blocks": [
    {
      "id": "layer",
      "name": "Layer",
      "serviceId": "sub-service",
      "description": "One transformer layer of GPT-2: causal self-attention where tokens look at earlier tokens, followed by an MLP where each token computes on its own. Both add their result to the stream.",
      "params": {
        "layer": 0,
        "mask": "causal",
        "window": 4,
        "temperature": 1,
        "disabledHeads": ""
      },
      "state": {
        "pipeline": [
          {
            "instanceId": "attention",
            "serviceId": "attention",
            "serviceName": "Attention",
            "state": {
              "model": "hkp-asset://gpt2-weights",
              "config": "hkp-asset://gpt2-config",
              "layer": "{{param.layer}}",
              "mask": "{{param.mask}}",
              "window": "{{param.window}}",
              "temperature": "{{param.temperature}}",
              "disabledHeads": "{{param.disabledHeads}}"
            }
          },
          {
            "instanceId": "mlp",
            "serviceId": "mlp",
            "serviceName": "MLP",
            "state": {
              "model": "hkp-asset://gpt2-weights",
              "config": "hkp-asset://gpt2-config",
              "layer": "{{param.layer}}"
            }
          }
        ]
      }
    }
  ],
  "runtimes": [
    {
      "id": "ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "python",
      "name": "hkp-python",
      "type": "rest",
      "remote": "python",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "out",
      "name": "Result",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "ui": [
