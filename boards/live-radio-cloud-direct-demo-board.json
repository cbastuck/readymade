{
  "boardName": "Live Radio (Cloud, direct)",
  "description": "Your microphone as an internet radio station. The hkp-rt runtime at home captures the mic, encodes it to MP3 and sends the stream over a WebSocket of its own to an hkp-node relay in the cloud; there a websocket-reader takes it in and the relay's endpoint passes it to every listener and serves the player page. The home machine needs no open port and uploads one stream however many people listen.\n\nThe home runtime connects to the relay itself rather than passing the stream through the window running the board, and keeps at most about a second waiting: on a poor uplink listeners skip ahead instead of falling behind. Live Radio (Cloud Relay) does the same with no secret and no writer, passing the stream along as the board's own flow.\n\nPoint the Relay runtime at your hkp-node server (it is 127.0.0.1:8080 here), and give the secret radio-ingest a value when asked: the relay accepts a stream only from whoever presents it. Press Start, then share the QR code or the player address.",
  "runtimes": [
    {
      "id": "home",
      "name": "Home (hkp-rt)",
      "type": "rest",
      "url": "http://127.0.0.1:8887",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "relay",
      "name": "Relay (hkp-node)",
      "type": "rest",
      "url": "http://127.0.0.1:8080",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "home": [
      {
        "uuid": "mic",
        "serviceId": "core-input",
        "serviceName": "Microphone",
        "state": {
          "bypass": true,
          "deferPropagation": true,
          "preferredSampleRate": 48000
        }
      },
      {
        "uuid": "encode",
        "serviceId": "audio-encode",
        "serviceName": "MP3",
        "state": {
          "format": "mp3",
          "stream": true,
          "sampleRate": 48000,
          "channels": 1,
          "bitrate": 128,
          "quality": 5
        }
      },
      {
        "uuid": "push",
        "serviceId": "websocket-writer",
        "serviceName": "To the relay",
        "state": {
          "bypass": true,
          "url": "hkp-mount://relay/ingest",
          "headers": {
            "Authorization": "Bearer {{secret.radio-ingest}}"
          },
          "maxQueueBytes": 16384
        }
      },
      {
        "uuid": "end",
        "serviceId": "stopper",
        "serviceName": "End Of Chain"
      }
    ],
    "relay": [
      {
        "uuid": "ingest",
        "serviceId": "websocket-reader",
        "serviceName": "Uplink",
        "state": {
          "bypass": true,
          "key": "{{secret.radio-ingest}}",
          "exclusive": true
        }
      },
      {
        "uuid": "radio",
        "serviceId": "http-server-subservices",
        "serviceName": "Relay",
        "state": {
          "bypass": true,
          "stream": {
            "path": "/live.mp3",
            "contentType": "audio/mpeg",
            "burstBytes": 0,
            "maxQueueBytes": 32768,
            "stallTimeoutMs": 5000
          },
          "onRequest": [
            {
              "instanceId": "player-page",
              "serviceId": "map",
              "serviceName": "Player page",
              "state": {
                "mode": "replace",
                "template": {
                  "meta": {
                    "status": 200,
                    "contentType": "text/html; charset=utf-8"
                  },
                  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Live Radio</title>\n<style>\n  :root { color-scheme: light dark; --fg: #111; --bg: #fafafa; --muted: #6b7280; --accent: #ef4444; }\n  @media (prefers-color-scheme: dark) { :root { --fg: #f3f4f6; --bg: #111; --muted: #9ca3af; } }\n  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--fg);\n         font: 16px/1.4 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n  main { display: grid; gap: 16px; justify-items: center; padding: 24px; text-align: center; }\n  h1 { margin: 0; font-size: 22px; font-weight: 600; }\n  button { width: 120px; height: 120px; border-radius: 50%; border: 0; background: var(--accent); color: #fff;\n           font-size: 18px; font-weight: 600; cursor: pointer; }\n  button[aria-pressed=\"true\"] { background: var(--fg); color: var(--bg); }\n  #status { color: var(--muted); min-height: 1.4em; font-variant-numeric: tabular-nums; }\n</style>\n</head>\n<body>\n<main>\n  <h1>Live Radio</h1>\n  <button id=\"toggle\" aria-pressed=\"false\">Listen</button>\n  <div id=\"status\">Tap to listen</div>\n</main>\n<script>\n// A live player that keeps its own buffer small.\n//\n// A plain <audio src> decides for itself how much to buffer before it starts\n// and never catches up — seconds behind live. This fetches the stream instead,\n// hands each piece to Media Source Extensions as it arrives, and holds the\n// playhead a fraction of a second behind the newest audio: nudging the rate up\n// a little when it drifts, jumping only when it has fallen far behind.\n// The stream sits beside this page, whether the page was opened at the\n// endpoint's bare address (an hkp-node mount has no trailing slash) or below it.\nconst PAGE = location.href.replace(/[?#].*$/, \"\");\nconst STREAM = new URL(\"live.mp3\", PAGE.endsWith(\"/\") ? PAGE : PAGE + \"/\").toString();\nconst TARGET = 0.4; // seconds of audio kept ahead of the playhead\nconst NUDGE = 0.7;  // beyond this, play 5% faster until back at the target\nconst JUMP = 2.0;   // beyond this, jump to the target\n\nconst Source = window.ManagedMediaSource || window.MediaSource;\nconst canStream = !!Source && Source.isTypeSupported(\"audio/mpeg\");\nconst toggle = document.getElementById(\"toggle\");\nconst status = document.getElementById(\"status\");\nlet session = null;\n\ntoggle.addEventListener(\"click\", () => (session ? stop() : start()));\n\n// ?autoplay starts without a tap, where the browser allows it (a kiosk, a\n// desktop that has allowed this site); ?debug logs what the status line says.\nconst options = new URLSearchParams(location.search);\nif (options.has(\"autoplay\")) start();\n\nfunction say(text) {\n  status.textContent = text;\n  if (options.has(\"debug\")) console.log(\"[player]\", text);\n}\n\nfunction start() {\n  toggle.setAttribute(\"aria-pressed\", \"true\");\n  toggle.textContent = \"Stop\";\n  session = canStream ? streamed() : plain();\n}\n\nfunction stop() {\n  session?.close();\n  session = null;\n  toggle.setAttribute(\"aria-pressed\", \"false\");\n  toggle.textContent = \"Listen\";\n  say(\"Tap to listen\");\n}\n\n// Without MSE: the browser's own player, with whatever delay it chooses.\nfunction plain() {\n  const audio = new Audio(STREAM);\n  audio.play().catch((e) => say(String(e)));\n  say(\"Live (this browser buffers on its own)\");\n  return { close: () => { audio.pause(); audio.removeAttribute(\"src\"); audio.load(); } };\n}\n\nfunction streamed() {\n  const audio = document.createElement(\"audio\");\n  audio.disableRemotePlayback = true; // required by ManagedMediaSource\n  const media = new Source();\n  audio.src = URL.createObjectURL(media);\n  const abort = new AbortController();\n  let closed = false;\n  let timer = null;\n\n  // play() inside the click keeps the gesture a browser asks for before sound.\n  audio.play().catch(() => {});\n  say(\"Connecting…\");\n\n  media.addEventListener(\"sourceopen\", async () => {\n    const buffer = media.addSourceBuffer(\"audio/mpeg\");\n    buffer.mode = \"sequence\"; // live: each piece follows the last, whatever its timestamps\n    const pending = [];\n    const feed = () => {\n      if (closed || buffer.updating || !pending.length) return;\n      try {\n        buffer.appendBuffer(pending[0]);\n        pending.shift();\n      } catch (e) {\n        // Full: drop what is long played and try again on the next update.\n        if (e.name === \"QuotaExceededError\" && audio.currentTime > 1) buffer.remove(0, audio.currentTime - 1);\n        else throw e;\n      }\n    };\n    buffer.addEventListener(\"updateend\", () => {\n      // Keep a few seconds behind the playhead, not the whole broadcast.\n      const played = audio.currentTime - 5;\n      if (!buffer.updating && played > 1 && buffer.buffered.length && buffer.buffered.start(0) < played) {\n        buffer.remove(0, played);\n        return;\n      }\n      feed();\n    });\n\n    try {\n      const response = await fetch(STREAM, { signal: abort.signal, cache: \"no-store\" });\n      const reader = response.body.getReader();\n      for (;;) {\n        const { value, done } = await reader.read();\n        if (done) break;\n        pending.push(value);\n        feed();\n      }\n      if (!closed) reconnect(\"The stream ended\");\n    } catch (e) {\n      if (!closed) reconnect(\"Connection lost\");\n    }\n  });\n\n  timer = setInterval(() => {\n    if (!audio.buffered.length) return;\n    const end = audio.buffered.end(audio.buffered.length - 1);\n    const ahead = end - audio.currentTime;\n    if (audio.paused && ahead >= TARGET) audio.play().catch(() => say(\"Tap to listen\"));\n    if (ahead > JUMP) {\n      audio.currentTime = end - TARGET;\n      audio.playbackRate = 1;\n    } else {\n      audio.playbackRate = ahead > NUDGE ? 1.05 : 1;\n    }\n    if (!audio.paused) say(`Live · ${ahead.toFixed(1)} s buffered`);\n  }, 250);\n\n  function reconnect(why) {\n    close();\n    say(`${why} — reconnecting…`);\n    setTimeout(() => { if (session === self) session = streamed(); }, 1000);\n  }\n\n  function close() {\n    closed = true;\n    clearInterval(timer);\n    abort.abort();\n    audio.pause();\n    audio.removeAttribute(\"src\");\n    audio.load();\n  }\n\n  const self = { close };\n  return self;\n}\n</script>\n</body>\n</html>\n"
                }
              }
            }
          ]
        }
      },
      {
        "uuid": "end",
        "serviceId": "stopper",
        "serviceName": "End Of Chain"
      }
    ]
  },
  "facade": {
    "layout": "single",
    "panels": [
      {
        "id": "station",
        "title": "Live Radio",
        "layout": {
          "direction": "column",
          "padding": 24,
          "gap": 16,
          "align": "center",
          "justify": "center",
          "fill": true,
          "items": [
            {
              "direction": "row",
              "gap": 12,
              "align": "center",
              "items": [
                {
                  "type": "status-indicator",
                  "source": {
                    "serviceUuid": "push",
                    "path": "status"
                  },
                  "statusColors": {
                    "connected": "#22c55e",
                    "connecting": "#f59e0b",
                    "reconnecting": "#f59e0b",
                    "waiting": "#f59e0b",
                    "idle": "#6b7280"
                  }
                },
                {
                  "type": "text",
                  "source": {
                    "serviceUuid": "push",
                    "path": "status"
                  },
                  "label": "Uplink:",
                  "placeholder": "idle"
                },
                {
                  "type": "text",
                  "source": {
                    "serviceUuid": "radio",
                    "path": "listeners"
                  },
                  "label": "Listening:",
                  "placeholder": "0"
                }
              ]
            },
            {
              "type": "text",
              "source": {
                "serviceUuid": "push",
                "path": "error"
              },
              "tone": "error",
              "placeholder": ""
            },
            {
              "type": "qr-code",
              "source": {
                "serviceUuid": "radio",
                "path": "__hkpMount"
              },
              "caption": "Scan to listen"
            },
            {
              "type": "text",
              "source": {
                "serviceUuid": "radio",
                "path": "__hkpMount"
              },
              "label": "Player:",
              "placeholder": "Press Start to go on air",
              "mono": true,
              "copyable": true
            },
            {
              "type": "text",
              "source": {
                "serviceUuid": "radio",
                "path": "streamUrl"
              },
              "label": "Stream (VLC):",
              "placeholder": "",
              "mono": true,
              "copyable": true
            },
            {
              "direction": "row",
              "gap": 12,
              "items": [
                {
                  "type": "button",
                  "label": "Start",
                  "actions": [
                    {
                      "type": "configure",
                      "serviceUuid": "ingest",
                      "configure": {
                        "bypass": false
                      }
                    },
                    {
                      "type": "configure",
                      "serviceUuid": "radio",
                      "configure": {
                        "bypass": false
                      }
                    },
                    {
                      "type": "configure",
                      "serviceUuid": "push",
                      "configure": {
                        "bypass": false
                      }
                    },
                    {
                      "type": "configure",
                      "serviceUuid": "mic",
                      "configure": {
                        "bypass": false
                      }
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "Stop",
                  "actions": [
                    {
                      "type": "configure",
                      "serviceUuid": "mic",
                      "configure": {
                        "bypass": true
                      }
                    },
                    {
                      "type": "configure",
                      "serviceUuid": "push",
                      "configure": {
                        "bypass": true
                      }
                    },
                    {
                      "type": "configure",
                      "serviceUuid": "radio",
                      "configure": {
                        "bypass": true
                      }
                    },
                    {
                      "type": "configure",
                      "serviceUuid": "ingest",
                      "configure": {
                        "bypass": true
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "notices": [
      {
        "source": {
          "serviceUuid": "mic",
          "path": "error"
        },
        "tone": "error"
      }
    ]
  }
}
