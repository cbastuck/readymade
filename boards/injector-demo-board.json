{
  "boardName": "Injector Demo",
  "description": "The Browser runtime shows Injector running in-process, with no backend needed. The Node runtime shows the same service behind hkp-node's REST API — needs hkp-node, kept as the remote `node`.",
  "runtimes": [
    {
      "id": "ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "node",
      "name": "Node",
      "type": "rest",
      "remote": "node",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "ui": [
      {
        "uuid": "injector-svc",
        "serviceId": "hookup.to/service/injector",
        "serviceName": "Injector",
        "state": {
          "recentInjection": "Hello from the Injector!"
        }
      },
      {
        "uuid": "monitor-svc",
        "serviceId": "hookup.to/service/monitor",
        "serviceName": "Monitor"
      }
    ],
    "node": [
      {
        "uuid": "node-injector-svc",
        "serviceId": "injector",
        "serviceName": "Injector",
        "state": {
          "recentInjection": "Hello from hkp-node!"
        }
      },
      {
        "uuid": "node-monitor-svc",
        "serviceId": "monitor",
        "serviceName": "Monitor"
      }
    ]
  }
}
