        "image": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20100%20100'%3E%3Cpath%20d='M8%2050%20L24%2038%20L24%2062%20Z'%20fill='%23f97316'/%3E%3Cpath%20d='M24%2036%20L70%2036%20Q94%2050%2070%2064%20L24%2064%20Z'%20fill='%23e2e8f0'/%3E%3Ccircle%20cx='62'%20cy='50'%20r='7'%20fill='%2338bdf8'%20stroke='%2364748b'%20stroke-width='2'/%3E%3Cpath%20d='M30%2036%20L20%2022%20L44%2036%20Z%20M30%2064%20L20%2078%20L44%2064%20Z'%20fill='%23ef4444'/%3E%3C/svg%3E",
