{
  "boardName": "Hacker Demo",
  "runtimes": [
    { "id": "ui", "name": "Browser", "type": "browser", "state": { "wrapServices": false } }
  ],
  "services": {
    "ui": [
      {
        "uuid": "timer-svc",
        "serviceId": "hookup.to/service/timer",
        "serviceName": "Timer",
        "state": { "periodic": true, "periodicValue": 50, "periodicUnit": "ms", "running": true, "start": true, "immediate": true }
      },
      {
        "uuid": "hacker-svc",
        "serviceId": "hookup.to/service/hacker/considered",
        "serviceName": "Angle",
        "state": {
          "buffer": "params.triggerCount * 0.18"
        }
      },
      {
        "uuid": "shape-svc",
        "serviceId": "hookup.to/service/map",
        "serviceName": "Shape",
        "state": {
          "mode": "replace",
          "template": {
            "type": "circle",
            "radius": 4,
            "x=": "round(sin(params + 1.5707963) * params * 10 + 300)",
            "y=": "round(sin(params) * params * 10 + 200)",
            "color=": "concat('hsl(', round(params * 10) % 360, ', 80%, 55%)')"
          }
        }
      },
      {
        "uuid": "canvas-svc",
        "serviceId": "hookup.to/service/canvas",
        "serviceName": "Canvas",
        "state": { "clearOnRedraw": false, "resizable": true, "size": [600, 400] }
      }
    ]
  }
}
