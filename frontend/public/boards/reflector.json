{
  "version": "2.0",
  "topology": {
    "type": "chain"
  },
  "runtimes": [
    {
      "id": "0f4dfa37-ac5c-4a50-8abf-a7ded3f7f620",
      "name": "Runtime",
      "type": "node",
      "services": [
        {
          "serviceName": "Ingress",
          "serviceId": "hookup.to/service/ingress",
          "path": "in",
          "op": "POST",
          "active": true,
          "wrapHeaders": true
        },
        {
          "serviceName": "Map",
          "serviceId": "hookup.to/service/map",
          "template": {
            "topic=": "params.headers['hkp-runtime-topic']",
            "data=": "params.data"
          }
        },
        {
          "serviceName": "Monitor",
          "serviceId": "hookup.to/service/monitor"
        },
        {
          "serviceName": "Websocket",
          "serviceId": "hookup.to/service/websocket",
          "name": "out",
          "keepAlive": true,
          "isPublic": true
        }
      ]
    }
  ]
}