      },
      {
        "serviceName": "Camera",
        "serviceId": "hookup.to/service/camera",
        "captureAs": "image"
      }
    ]
  },
  "2802ecf0-6684-4498-bde6-8a75f774786f": {
    "name": "dispatcher",
    "type": "node",
    "services": [
      {
        "serviceName": "Monitor",
        "serviceId": "hookup.to/service/monitor"
      }
    ]
  },
  "ee54bfd4-0f56-4f25-8776-5169d89800b9": {
    "name": "phone",
    "type": "browser",
    "services": [
      {
        "serviceName": "Map",
        "serviceId": "hookup.to/service/map",
        "template": {
          "type": "image",
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 200,
          "data=": "params.image"
