      {
        "uuid": "7668e6b8-f3db-414f-b4b2-975869f74aed",
        "periodic": true,
        "periodicValue": 1,
        "periodicUnit": "s",
        "oneShotDelay": 0,
        "running": true,
        "serviceId": "hookup.to/service/timer",
        "serviceName": "Timer"
      },
      {
        "uuid": "72d59f3a-64b5-485e-9091-f80151090436",
        "template": {
          "left=": "params.triggerCount === 1 ? round(rand() * 10) : undefined",
          "right=": "params.triggerCount === 1 ? round(rand() * 10) : undefined",
          "score=": "max(11 - params.triggerCount, 0)"
        },
        "serviceId": "hookup.to/service/map",
        "serviceName": "Dice"
      },
      {
        "uuid": "a4aa5ec8-a16b-44dd-93a4-9dbda020e25d",
        "update": "process",
        "serviceId": "hookup.to/service/cache",
        "serviceName": "Cache"
      },
      {
        "uuid": "c097bb61-d381-46a9-80de-8fd2669a1ac6",
        "mode": "add",
        "template": {
          "correct=": "params.answer && (number(params.answer) === params.left * params.right)"
        },
        "serviceId": "hookup.to/service/map",
        "serviceName": "Evaluate"
      },
      {
        "logToConsole": false,
        "serviceId": "hookup.to/service/monitor",
        "serviceName": "Monitor"
      },
      {
        "uuid": "f6705989-539c-4576-bde6-a8888e269c4b",
        "serviceId": "hookup.to/service/map",
        "serviceName": "Update",
        "mode": "overwrite",
        "template": {
          "restart=": "params.correct",
          "resetReducer=": "params.correct",
          "answer=": "params.correct ? '' : params.answer",
          "overallScore=": "params.correct ? ((params.overallScore || 0) + params.score) : (params.overallScore || 0)",
          "numGames=": "params.correct ? (params.numGames || 0) + 1 : (params.numGames || 0)",
          "cacheProperties+": ["answer", "overallScore", "numGames"]
        }
      }
    ],
