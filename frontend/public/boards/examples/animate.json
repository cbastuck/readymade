{
  "b73af90e-537b-46ba-b7aa-3870cfd2d958": {
    "id": "b73af90e-537b-46ba-b7aa-3870cfd2d958",
    "name": "Chrome-78.0.3904.108 (0)",
    "type": "browser",
    "bundles": ["hookup.to/registry/browser/Graphic"],
    "services": [
      {
        "serviceName": "Timer",
        "serviceId": "hookup.to/service/timer",
        "periodic": true,
        "periodicValue": 40,
        "periodicUnit": "ms",
        "start": true
      },
      {
        "serviceName": "Group",
        "serviceId": "hookup.to/service/group",
        "aggregator": "array",
        "services": [
          {
            "serviceName": "Map",
            "serviceId": "hookup.to/service/map",
            "template": {
              "type": "text",
              "text": "🌲",
              "x=": "(params.triggerCount / 5) % 100 + \"%\"",
              "y": "95%"
            }
          },
          {
            "serviceName": "Map",
            "serviceId": "hookup.to/service/map",
            "template": {
              "type": "text",
              "text": "🚶‍♀️",
              "x=": "100 - params.triggerCount % 100 + \"%\"",
              "y=": "round(95 - sin(params.triggerCount) * 2) + \"%\""
            }
          }
        ]
      },
      {
        "serviceName": "Monitor",
        "serviceId": "hookup.to/service/monitor"
      },
      {
        "serviceName": "Canvas",
        "serviceId": "hookup.to/service/canvas",
        "capture": "image/png"
      },
      {
        "serviceName": "GIF Recorder",
        "serviceId": "hookup.to/service/gif-encoder"
      }
    ]
  }
}