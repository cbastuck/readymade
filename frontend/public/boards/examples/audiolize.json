
{
  "ExampleRuntime": {
    "bundles": ["hookup.to/registry/browser/Audio"],
    "type": "browser",
    "services": [
      {
        "serviceName": "Input",
        "serviceId": "hookup.to/service/input",
        "eventSourceURL": "https://stream.wikimedia.org/v2/stream/recentchange",
        "running": true
      },
      {
        "serviceName": "Stack",
        "serviceId": "hookup.to/service/stack",
        "input": "multiplex",
        "output": "array",
        "services": [
          {
            "serviceName": "Map Snare / Hihat",
            "serviceId": "hookup.to/service/map",
            "template": {
              "note=": "params.bot ? 'D4' : 'E4'" 
            }
          },
          {
            "serviceName": "Map Base",
            "serviceId": "hookup.to/service/map",
            "template": {
              "note=": "(!params.bot && rand() < 0.2)  ? 'C4' : null" 
            } 
          }
        ]
      },
      {
        "serviceName": "Stack",
        "serviceId": "hookup.to/service/stack",
        "input": "lanes",
        "output": "array",
        "services": [
          {
            "serviceName": "Aggregate Snare / Hihat",
            "serviceId": "hookup.to/service/aggregator",
            "interval": "90",
            "property": "note",
            "aggregator": "val_max_occ"
          },
          {
            "serviceName": "Aggregate Base",
            "serviceId": "hookup.to/service/aggregator",
            "interval": "180",
            "property": "note"
          }
        ]
      },
      {
        "serviceName": "Sound",
        "serviceId": "hookup.to/service/sound",
        "generator": {
          "type": "sampler",
          "urls": {
            "C4": "/assets/audio/base.wav",
            "D4": "/assets/audio/snare.wav",
            "E4": "/assets/audio/hihat.wav"
          }
        }
      }
    ]
  }
}