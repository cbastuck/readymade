{
  "name": "frontend-v5",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "event-source-polyfill": "^1.0.25",
    "jwt-decode": "^3.1.2",
    "moment": "^2.29.1",
    "monaco-editor": "^0.32.1",
    "peerjs": "^1.3.2",
    "qrcode": "^1.5.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^6.2.1",
    "resize-observer-polyfill": "^1.5.1",
    "semantic-ui-css": "github:Semantic-Org/Semantic-UI-CSS",
    "semantic-ui-offline": "*",
    "semantic-ui-react": "^2.1.2",
    "services": "file:../shared/services",
    "setimmediate": "^1.0.5",
    "ua-parser-js": "^1.0.2",
    "unique-names-generator": "^4.7.1",
    "uuid": "^8.3.2",
    "web-streams-polyfill": "^3.2.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "react-scripts": "5.0.0",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.3",
    "@testing-library/user-event": "^13.5.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": " react-scripts build && node replaceOnlineFonts.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "rsync -avz --progress --exclude node_modules build/* xeon:frontend",
    "push": "npm run build && docker build -f docker/Dockerfile -t localhost:5001/hkp-frontend . && docker push localhost:5001/hkp-frontend",
    "build-bridge": "parcel build --out-dir build-bridge --out-file index.js --public-url /bridge --no-source-maps --cache-dir ./parcel-cache --target browser bridge/index.js",
    "deploy-bridge": "rsync -avz --progress --exclude node_modules build-bridge/* xeon:bridge",
    "prettier": "prettier --write \"src/**/*.js\"",
    "ssl": "HTTPS=true SSL_CRT_FILE=cert/server.crt SSL_KEY_FILE=cert/server.key npm start"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}