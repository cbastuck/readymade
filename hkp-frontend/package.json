{
  "name": "hkp-frontend",
  "version": "0.2",
  "private": true,
  "dependencies": {
    "@auth0/auth0-react": "^2.2.3",
    "@monaco-editor/react": "^4.4.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.3",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "event-source-polyfill": "^1.0.25",
    "jwt-decode": "^3.1.2",
    "lz-string": "^1.5.0",
    "moment": "^2.29.1",
    "peerjs": "^1.3.2",
    "qrcode": "^1.5.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^6.2.1",
    "resize-observer-polyfill": "^1.5.1",
    "semantic-ui-css": "github:Semantic-Org/Semantic-UI-CSS",
    "semantic-ui-offline": "*",
    "semantic-ui-react": "^2.1.4",
    "setimmediate": "^1.0.5",
    "typescript": "^5.2.2",
    "ua-parser-js": "^1.0.2",
    "unique-names-generator": "^4.7.1",
    "uuid": "^8.3.2",
    "web-streams-polyfill": "^3.2.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/event-source-polyfill": "^1.0.2",
    "@types/qrcode": "^1.5.2",
    "@types/ua-parser-js": "^0.7.37",
    "@types/uuid": "^9.0.4",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": " npm run updateBuildNumber && react-app-rewired build && node replaceOnlineFonts.js",
    "test": "react-app-rewired test",
    "eject": "react-app-rewired eject",
    "deployXeon": "rsync -avz --progress --exclude node_modules build/* xeon:frontend",
    "deploy": "aws s3 cp build/ s3://hkp-frontend --recursive --profile hkp-s3-uploader",
    "push": "npm run build && docker build -f docker/Dockerfile -t localhost:5001/hkp-frontend . && docker push localhost:5001/hkp-frontend",
    "prettier": "prettier --write \"src/**/*.js\"",
    "ssl": "HTTPS=true SSL_CRT_FILE=cert/server.crt SSL_KEY_FILE=cert/server.key npm start",
    "audit": "npm audit --production",
    "updateBuildNumber": "node ./updateBuildNumber.js",
    "invalidateCDN": "aws cloudfront create-invalidation --distribution-id E3SKF64N6ROA32 --paths '/index.html' --profile hkp-s3-uploader"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
