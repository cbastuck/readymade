{
  "boardName": "Peer Chat",
  "facade": {
    "layout": "single",
    "panels": [
      {
        "id": "chat",
        "layout": {
          "direction": "column",
          "grow": true,
          "items": [
            {
              "direction": "row",
              "justify": "space-between",
              "align": "center",
              "gap": 12,
              "padding": 8,
              "items": [
                {
                  "direction": "column",
                  "gap": 2,
                  "items": [
                    {
                      "type": "text",
                      "label": "You:",
                      "source": {
                        "serviceUuid": "chat-peer-svc",
                        "path": "peerName"
                      },
                      "placeholder": "connecting…"
                    },
                    {
                      "type": "text",
                      "label": "Talking to:",
                      "tone": "muted",
                      "source": {
                        "serviceUuid": "chat-peer-svc",
                        "path": "targetPeer"
                      },
                      "placeholder": "nobody yet"
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "Guest Board",
                  "actions": [{ "type": "board", "action": "partner-board-qr" }]
                }
              ]
            },
            {
              "type": "message-list",
              "grow": true,
              "source": { "serviceUuid": "chat-monitor-svc" },
              "composer": {
                "placeholder": "Type a message…",
                "submitLabel": "Send",
                "action": {
                  "serviceUuid": "chat-input-svc",
                  "configure": { "inject": "$$input" }
                }
              }
            }
          ]
        }
      }
    ]
  },
  "runtimes": [
    {
      "id": "chat-browser",
      "name": "Browser",
      "type": "browser",
      "state": { "wrapServices": false, "minimized": false }
    }
  ],
  "services": {
    "chat-browser": [
      {
        "uuid": "chat-input-svc",
        "serviceId": "hookup.to/service/injector",
        "serviceName": "Message",
        "state": { "plainText": true }
      },
      {
        "uuid": "chat-peer-svc",
        "serviceId": "hookup.to/service/peer-socket",
        "serviceName": "Peer Socket",
        "state": {
          "mode": "Receive and Send",
          "extractIncomingData": true,
          "peerPath": "/",
          "peerHost": "peerjs.hookitapp.com",
          "peerSecure": true
        }
      },
      {
        "uuid": "chat-monitor-svc",
        "serviceId": "hookup.to/service/monitor",
        "serviceName": "Incoming Messages"
      },
      {
        "uuid": "chat-stopper-svc",
        "serviceId": "hookup.to/service/stopper",
        "serviceName": "Stopper"
      }
    ]
  }
}
