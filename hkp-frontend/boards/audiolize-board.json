{
  "boardName": "Audiolize",
  "runtimes": [
    {
      "id": "ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false,
        "minimized": false
      }
    }
  ],
  "services": {
    "ui": [
      {
        "uuid": "input-svc",
        "serviceId": "hookup.to/service/input",
        "serviceName": "Wikipedia Recent Changes",
        "state": {
          "url": "https://stream.wikimedia.org/v2/stream/recentchange",
          "running": true
        }
      },
      {
        "uuid": "notes-svc",
        "serviceId": "tracks",
        "serviceName": "Tracks",
        "state": {
          "run": "serial",
          "tracks": [
            {
              "name": "snare",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "snare",
                  "serviceName": "Snare / Hihat",
                  "state": {
                    "template": {
                      "note=": "params.bot ? 'D4' : 'E4'"
                    }
                  }
                }
              ]
            },
            {
              "name": "bass",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "bass",
                  "serviceName": "Bass",
                  "state": {
                    "template": {
                      "note=": "(!params.bot && rand() < 0.2) ? 'C4' : null"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "uuid": "aggregates-svc",
        "serviceId": "tracks",
        "serviceName": "Tracks",
        "state": {
          "run": "serial",
          "tracks": [
            {
              "name": "snare",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "snare-lane",
                  "serviceName": "The snare note",
                  "state": {
                    "arrayMode": "single",
                    "template": {
                      "=": "params[0]"
                    }
                  }
                },
                {
                  "serviceId": "hookup.to/service/aggregator",
                  "instanceId": "snare",
                  "serviceName": "Snare / Hihat Aggregator",
                  "state": {
                    "interval": 90,
                    "property": "note",
                    "aggregator": "val_max_occ"
                  }
                }
              ]
            },
            {
              "name": "bass",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "bass-lane",
                  "serviceName": "The bass note",
                  "state": {
                    "arrayMode": "single",
                    "template": {
                      "=": "params[1]"
                    }
                  }
                },
                {
                  "serviceId": "hookup.to/service/aggregator",
                  "instanceId": "bass",
                  "serviceName": "Bass Aggregator",
                  "state": {
                    "interval": 180,
                    "property": "note"
                  }
                }
              ]
            }
          ],
          "reduce": [
            {
              "instanceId": "played",
              "serviceId": "hookup.to/service/map",
              "serviceName": "Anything to play",
              "state": {
                "mode": "replace",
                "arrayMode": "single",
                "template": {
                  "=": "filter(params.results, 'item !== null').length ? params.results : null"
                }
              }
            }
          ]
        }
      },
      {
        "uuid": "sound-svc",
        "serviceId": "hookup.to/service/sound",
        "serviceName": "Sound",
        "state": {
          "generator": {
            "type": "drums"
          }
        }
      }
    ]
  }
}
