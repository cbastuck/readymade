{
  "boardName": "Radio Library",
  "description": "A folder of audio, served. Whatever is written into the volume this names is readable over one address: ask the address itself for a listing, or a path under it for the file, with the content type its extension means and range requests answered so a player can seek.\n\nThe listing is JSON, because a store answers callers rather than browsers \u2014 the panel here turns it into something to click, and a player wants the feed the Radio publishes rather than either. A file opened on its own does play in a browser: it is an audio/mpeg response, which is all a browser needs.\n\nIt is the public half of the library and nothing else: the Storage services here are read-only, which is what makes an unauthenticated endpoint safe to hand out. Writing happens through a different instance, inside the board that renders \u2014 see the Radio unit.\n\nStorage names a place on the board rather than a place on a disk: what actually holds the bytes is its nested pipeline, `filesystem` here. Swapping that for something speaking S3 changes nothing outside this service.\n\nTwo boards share a volume by naming the same one, the way two boards share a database. Needs hkp-node on port 8080.",
  "unit": {
    "name": "library",
    "params": {
      "volume": "radio"
    }
  },
  "runtimes": [
    {
      "id": "files",
      "name": "Library",
      "type": "rest",
      "url": "http://127.0.0.1:8080",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "files": [
      {
        "uuid": "listen",
        "serviceId": "http-server-subservices",
        "serviceName": "Listen",
        "state": {
          "bypass": false,
          "mode": "process_on_session",
          "mountName": "listen",
          "pipeline": [
            {
              "instanceId": "episodes",
              "serviceId": "storage",
              "serviceName": "Episodes",
              "state": {
                "readOnly": true,
                "prefix": "episodes",
                "pipeline": [
                  {
                    "instanceId": "files",
                    "serviceId": "filesystem",
                    "serviceName": "Files",
                    "state": {
                      "volume": "{{param.volume}}"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "uuid": "end",
        "serviceId": "stopper",
        "serviceName": "End of the call",
        "state": {}
      },
      {
        "uuid": "sweep",
        "serviceId": "timer",
        "serviceName": "Look again",
        "state": {
          "periodic": true,
          "periodicValue": 60,
          "periodicUnit": "s",
          "running": true
        }
      },
      {
        "uuid": "browse",
        "serviceId": "storage",
        "serviceName": "What is there",
        "state": {
          "readOnly": true,
          "prefix": "episodes",
          "pipeline": [
            {
              "instanceId": "files",
              "serviceId": "filesystem",
              "serviceName": "Files",
              "state": {
                "volume": "{{param.volume}}"
              }
            }
          ]
        }
      },
      {
        "uuid": "pick",
        "serviceId": "map",
        "serviceName": "Just the files",
        "state": {
          "mode": "replace",
          "template": {
            "=": "params.body.files"
          }
        }
      },
      {
        "uuid": "link",
        "serviceId": "map",
        "serviceName": "Where each one plays",
        "state": {
          "mode": "replace",
          "arrayMode": "array",
          "template": {
            "path=": "params.path",
            "kb=": "round(params.size / 1024)",
            "base": "hkp-mount://files/listen",
            "type=": "params.contentType",
            "when=": "params.modified"
          }
        }
      },
      {
        "uuid": "shown",
        "serviceId": "map",
        "serviceName": "The listing",
        "state": {
          "mode": "replace",
          "arrayMode": "single",
          "template": {
            "episodes=": "params"
          }
        }
      },
      {
        "uuid": "seen",
        "serviceId": "monitor",
        "serviceName": "Listing",
        "state": {}
      },
      {
        "uuid": "m3u-doc",
        "serviceId": "sql",
        "serviceName": "The volume as a playlist",
        "state": {
          "mode": "query",
          "statement": "SELECT '#EXTM3U' || char(10)\n    || IFNULL(group_concat(entry, char(10) ORDER BY sortKey DESC), '')\n    || char(10) AS playlist\n  FROM (\n    SELECT '#EXTINF:-1,' || replace(replace(name, char(13), ' '), char(10), ' ') || char(10)\n        || base || '/' || path AS entry,\n           sortKey\n      FROM (\n        SELECT json_extract(value, '$.path') AS path,\n               json_extract(value, '$.base') AS base,\n               json_extract(value, '$.type') AS type,\n               json_extract(value, '$.when') AS sortKey,\n               CASE\n                 WHEN json_extract(value, '$.path') LIKE '%.mp3'\n                 THEN substr(json_extract(value, '$.path'), 1, length(json_extract(value, '$.path')) - 4)\n                 ELSE json_extract(value, '$.path')\n               END AS name\n          FROM json_each($episodes)\n      )\n     WHERE type LIKE 'audio/%'\n  )"
        }
      },
      {
        "uuid": "m3u-wrap",
        "serviceId": "map",
        "serviceName": "As a playlist file",
        "state": {
          "mode": "replace",
          "template": {
            "meta.status": 200,
            "meta.contentType": "audio/x-mpegurl; charset=utf-8",
            "meta.headers.content-disposition": "inline; filename=\"library.m3u\"",
            "body=": "params.rows[0].playlist"
          }
        }
      },
      {
        "uuid": "m3u-serve",
        "serviceId": "http-server-subservices",
        "serviceName": "Serve the playlist",
        "state": {
          "bypass": false,
          "mode": "process_on_data",
          "mountName": "playlist",
          "pipeline": []
        }
      }
    ]
  },
  "facade": {
    "layout": "single",
    "panels": [
      {
        "id": "library",
        "title": "Library",
        "layout": {
          "direction": "column",
          "gap": 14,
          "align": "stretch",
          "paddingX": 16,
          "paddingY": 16,
          "items": [
            {
              "type": "text",
              "placeholder": "Every file in the volume, played as one sitting: press play and it runs to the end of the list.",
              "tone": "muted",
              "fontSize": 12
            },
            {
              "direction": "row",
              "gap": 10,
              "align": "center",
              "items": [
                {
                  "type": "button",
                  "label": "Refresh",
                  "actions": [
                    {
                      "type": "process",
                      "serviceUuid": "browse",
                      "payload": {
                        "op": "list"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "label": "Playlist",
                  "source": {
                    "serviceUuid": "m3u-serve",
                    "path": "__hkpMount"
                  },
                  "placeholder": "not published yet",
                  "fontSize": 11,
                  "wrap": true,
                  "grow": true,
                  "copyable": true
                }
              ]
            },
            {
              "type": "audio-player",
              "source": {
                "serviceUuid": "seen",
                "path": "episodes"
              },
              "url": "{{item.base}}/{{item.path}}",
              "subtitle": "{{item.kb}} kB",
              "placeholder": "Nothing in the volume yet."
            },
            {
              "type": "text",
              "placeholder": "Hand the playlist address to VLC, Music or any other player and the whole volume queues up there. The listing address below answers JSON \u2014 it is what a tool reads, not a player.",
              "tone": "muted",
              "fontSize": 11
            },
            {
              "type": "text",
              "label": "Listing",
              "source": {
                "serviceUuid": "listen",
                "path": "__hkpMount"
              },
              "placeholder": "not published yet",
              "tone": "muted",
              "fontSize": 11,
              "wrap": true,
              "copyable": true
            },
            {
              "type": "qr-code",
              "caption": "Scan to open the playlist",
              "source": {
                "serviceUuid": "m3u-serve",
                "path": "__hkpMount"
              }
            }
          ]
        }
      }
    ],
    "init": [
      {
        "type": "process",
        "serviceUuid": "browse",
        "payload": {
          "op": "list"
        }
      }
    ]
  }
}
