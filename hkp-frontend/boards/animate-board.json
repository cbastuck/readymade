{
  "boardName": "Animate",
  "runtimes": [
    {
      "id": "ui",
      "name": "Browser",
      "type": "browser",
      "state": {
        "wrapServices": false,
        "minimized": false
      }
    }
  ],
  "services": {
    "ui": [
      {
        "uuid": "timer-svc",
        "serviceId": "hookup.to/service/timer",
        "serviceName": "Timer",
        "state": {
          "periodic": true,
          "periodicValue": 40,
          "periodicUnit": "ms",
          "running": true,
          "start": true
        }
      },
      {
        "uuid": "tracks-svc",
        "serviceId": "tracks",
        "serviceName": "Tracks",
        "state": {
          "run": "serial",
          "tracks": [
            {
              "name": "☀️",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "t0",
                  "serviceName": "Sun",
                  "state": {
                    "template": {
                      "type": "text",
                      "text": "\u2600\ufe0f",
                      "x=": "100 - (params.triggerCount / 50) % 100 + \"%\"",
                      "y": "20%"
                    }
                  }
                }
              ]
            },
            {
              "name": "☁️",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "t1",
                  "serviceName": "Cloud",
                  "state": {
                    "template": {
                      "type": "text",
                      "text": "\u2601\ufe0f",
                      "x=": "-12 + (params.triggerCount / 20) % 150 + \"%\"",
                      "y": "15%"
                    }
                  }
                }
              ]
            },
            {
              "name": "🌳",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "t2",
                  "serviceName": "Distant Tree",
                  "state": {
                    "template": {
                      "type": "text",
                      "text": "\ud83c\udf33",
                      "x=": "-20 + (params.triggerCount / 7) % 150 + \"%\"",
                      "y": "65%"
                    }
                  }
                }
              ]
            },
            {
              "name": "🌲",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "t3",
                  "serviceName": "Near Tree",
                  "state": {
                    "template": {
                      "type": "text",
                      "text": "\ud83c\udf32",
                      "x=": "-40 + (params.triggerCount / 2.5) % 150 + \"%\"",
                      "y": "85%"
                    }
                  }
                }
              ]
            },
            {
              "name": "🚶‍♀️",
              "pipeline": [
                {
                  "serviceId": "hookup.to/service/map",
                  "instanceId": "t4",
                  "serviceName": "Walker",
                  "state": {
                    "template": {
                      "type": "text",
                      "text": "\ud83d\udeb6\u200d\u2640\ufe0f",
                      "x=": "100 - min(params.triggerCount, 50) + \"%\"",
                      "y=": "round(95 - sin(params.triggerCount / 1.3) * 2) + \"%\""
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "uuid": "monitor-svc",
        "serviceId": "hookup.to/service/monitor",
        "serviceName": "Monitor"
      },
      {
        "uuid": "canvas-svc",
        "serviceId": "hookup.to/service/canvas",
        "serviceName": "Canvas",
        "state": {
          "size": [400, 250],
          "clearOnRedraw": true,
          "resizable": true,
          "capture": true
        }
      },
      {
        "uuid": "gif-svc",
        "serviceId": "hookup.to/service/gif-encoder",
        "serviceName": "GIF Recorder",
        "state": {
          "recording": false,
          "delayMs": 40,
          "maxFrames": 300,
          "loop": true,
          "autoDownload": false,
          "filename": "animation.gif"
        }
      }
    ]
  }
}
