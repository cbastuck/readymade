{
  "boardName": "Voice Assistant (hkp-rt)",
  "description": "A fully local voice assistant running entirely on the C++ runtime: push Record, speak, push Stop — the browser captures 16 kHz PCM audio and ships it to the hkp-rt runtime, where speech-to-text (Whisper via sherpa-onnx) transcribes it, text-generation answers via embedded llama.cpp, and text-to-speech (Kokoro via sherpa-onnx) synthesizes the reply, which plays back through the browser Audio Output. Requires an hkp-rt runtime on port 8887 built with -DHKP_SPEECH_ENABLED=ON and -DHKP_LLAMA_ENABLED=ON (launch: `hkp-rt 8887`). Models expected under ~/Development/claude/models: sherpa-onnx-whisper-tiny (multilingual, not .en), kokoro-en-v0_19, and a GGUF for the LLM. Keep utterances short (~5 s): one FloatRingBuffer hop is capped at ~88200 samples (~5.5 s at 16 kHz in, ~3.67 s at 24 kHz out).",
  "runtimes": [
    {
      "id": "recorder",
      "name": "Recorder",
      "type": "browser",
      "state": {
        "wrapServices": false,
        "minimized": false
      }
    },
    {
      "id": "rt",
      "name": "hkp-rt",
      "type": "rest",
      "url": "http://127.0.0.1:8887",
      "state": {
        "wrapServices": false,
        "minimized": false
      }
    },
    {
      "id": "playback",
      "name": "Playback",
      "type": "browser",
      "state": {
        "wrapServices": false,
        "minimized": false
      }
    }
  ],
  "services": {
    "recorder": [
      {
        "uuid": "mic",
        "serviceId": "hookup.to/service/audio-input",
        "serviceName": "Microphone",
        "state": {
          "format": "pcm",
          "pcmSampleRate": 16000,
          "timeslice": 1000
        }
      }
    ],
    "rt": [
      {
        "uuid": "stt",
        "serviceId": "speech-to-text",
        "serviceName": "Speech To Text",
        "state": {
          "backend": "local",
          "encoderPath": "~/Development/claude/models/sherpa-onnx-whisper-tiny/tiny-encoder.onnx",
          "decoderPath": "~/Development/claude/models/sherpa-onnx-whisper-tiny/tiny-decoder.onnx",
          "tokensPath": "~/Development/claude/models/sherpa-onnx-whisper-tiny/tiny-tokens.txt",
          "language": "auto",
          "sampleRate": 16000
        }
      },
      {
        "uuid": "transcript-monitor",
        "serviceId": "monitor",
        "serviceName": "Transcript"
      },
      {
        "uuid": "llm",
        "serviceId": "text-generation",
        "serviceName": "Text Generation (local)",
        "state": {
          "backend": "local",
          "modelPath": "~/Development/claude/models/Qwen3-0.6B-Q8_0.gguf",
          "contextSize": 4096,
          "gpuLayers": -1,
          "systemPrompt": "You are a helpful assistant. Answer in one or two short spoken sentences — no markdown, no lists. /no_think",
          "temperature": 0.7,
          "topP": 0.95,
          "topK": 20,
          "maxTokens": 512,
          "stream": false
        }
      },
      {
        "uuid": "answer-monitor",
        "serviceId": "monitor",
        "serviceName": "Answer"
      },
      {
        "uuid": "tts",
        "serviceId": "text-to-speech",
        "serviceName": "Text To Speech",
        "state": {
          "backend": "local",
          "modelPath": "~/Development/claude/models/kokoro-en-v0_19/model.onnx",
          "voicesPath": "~/Development/claude/models/kokoro-en-v0_19/voices.bin",
          "tokensPath": "~/Development/claude/models/kokoro-en-v0_19/tokens.txt",
          "dataDir": "~/Development/claude/models/kokoro-en-v0_19/espeak-ng-data",
          "speakerId": 0,
          "speed": 1.0
        }
      }
    ],
    "playback": [
      {
        "uuid": "speaker",
        "serviceId": "hookup.to/service/audio-output",
        "serviceName": "Audio Output",
        "state": {
          "sampleRate": 24000
        }
      }
    ]
  },
  "facade": {
    "layout": "single",
    "panels": [
      {
        "id": "voice-assistant",
        "title": "Voice Assistant (hkp-rt)",
        "layout": {
          "direction": "column",
          "padding": 24,
          "gap": 16,
          "align": "center",
          "justify": "center",
          "fill": true,
          "items": [
            {
              "direction": "row",
              "gap": 12,
              "items": [
                {
                  "type": "status-indicator",
                  "source": {
                    "serviceUuid": "stt",
                    "path": "status"
                  },
                  "statusColors": {
                    "idle": "#22c55e",
                    "loading": "#3b82f6",
                    "transcribing": "#f59e0b",
                    "error": "#ef4444"
                  }
                },
                {
                  "type": "status-indicator",
                  "source": {
                    "serviceUuid": "llm",
                    "path": "status"
                  },
                  "statusColors": {
                    "idle": "#22c55e",
                    "loading": "#3b82f6",
                    "generating": "#f59e0b",
                    "error": "#ef4444"
                  }
                },
                {
                  "type": "status-indicator",
                  "source": {
                    "serviceUuid": "tts",
                    "path": "status"
                  },
                  "statusColors": {
                    "idle": "#22c55e",
                    "loading": "#3b82f6",
                    "generating": "#f59e0b",
                    "error": "#ef4444"
                  }
                }
              ]
            },
            {
              "direction": "row",
              "gap": 12,
              "fill": true,
              "items": [
                {
                  "type": "message-list",
                  "source": {
                    "serviceUuid": "transcript-monitor",
                    "path": "text"
                  }
                },
                {
                  "type": "message-list",
                  "source": {
                    "serviceUuid": "answer-monitor",
                    "path": "text"
                  }
                }
              ]
            },
            {
              "direction": "row",
              "gap": 12,
              "items": [
                {
                  "type": "button",
                  "label": "Record",
                  "indicator": {
                    "source": {
                      "serviceUuid": "mic",
                      "path": "isRecording"
                    },
                    "statusColors": {
                      "true": "#ef4444",
                      "false": "#6b7280"
                    }
                  },
                  "action": {
                    "serviceUuid": "mic",
                    "configure": {
                      "command": {
                        "action": "start-recording"
                      }
                    }
                  }
                },
                {
                  "type": "button",
                  "label": "■ Stop & Answer",
                  "action": {
                    "serviceUuid": "mic",
                    "configure": {
                      "command": {
                        "action": "stop-recording"
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
