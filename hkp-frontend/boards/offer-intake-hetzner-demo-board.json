{
  "boardName": "Offer Intake (Hetzner)",
  "description": "Enquiries arrive and wait. A person approves the ones worth processing; each approved one is read, extracted into fields, and written on. Extraction runs against Hetzner's hosted inference API, which needs one thing set on the Extract Offer service: apiKey. It is write-only — configure it on the panel and it is never saved back into this board. The model is preset to Qwen/Qwen3.6-35B-A3B-FP8; the endpoint also serves Qwen3.8-27B, and lists whatever it currently has: curl -s https://inference.hetzner.com/api/v1/models -H \"Authorization: Bearer $TOKEN\"",
  "runtimes": [
    {
      "id": "intake",
      "name": "1 · Intake",
      "type": "rest",
      "url": "http://127.0.0.1:8080",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "queue",
      "name": "2 · Waiting",
      "type": "rest",
      "url": "http://127.0.0.1:8080",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "process",
      "name": "3 · Processing",
      "type": "rest",
      "url": "http://127.0.0.1:8080",
      "state": {
        "wrapServices": false
      }
    },
    {
      "id": "requeue",
      "name": "4 · Back to waiting",
      "type": "rest",
      "url": "http://127.0.0.1:8080",
      "state": {
        "wrapServices": false
      }
    }
  ],
  "services": {
    "intake": [
      {
        "uuid": "intake",
        "serviceId": "http-server-subservices",
        "serviceName": "Enquiry Webhook",
        "state": {
          "mountName": "missive-intake",
          "mode": "process_on_session",
          "pipeline": [
            {
              "uuid": "dump",
              "serviceId": "store",
              "serviceName": "Dump",
              "state": {
                "mode": "put",
                "keyFrom": "body.id",
                "valueFrom": "body"
              }
            }
          ]
        }
      },
      {
        "uuid": "after-intake",
        "serviceId": "stopper",
        "serviceName": "Stored — Nothing Else Runs"
      }
    ],
    "queue": [
      {
        "uuid": "refresh",
        "serviceId": "timer",
        "serviceName": "Queue Refresh",
        "state": {
          "periodic": true,
          "periodicValue": 5,
          "periodicUnit": "s",
          "start": true
        }
      },
      {
        "uuid": "queue",
        "serviceId": "store",
        "serviceName": "Waiting",
        "state": {
          "mode": "list",
          "show": "all",
          "limit": 100
        }
      },
      {
        "uuid": "after-queue",
        "serviceId": "stopper",
        "serviceName": "The Panel Reads This"
      }
    ],
    "process": [
      {
        "uuid": "approved",
        "serviceId": "store",
        "serviceName": "Approved",
        "state": {
          "mode": "release"
        }
      },
      {
        "uuid": "as-prompt",
        "serviceId": "map",
        "serviceName": "As Prompt",
        "state": {
          "mode": "replace",
          "template": {
            "key=": "params.key",
            "text=": "'From: ' + (params.value.from || '(unknown)') + '\\nSubject: ' + (params.value.subject || '(none)') + '\\n\\n' + (params.value.text || params.value.body || JSON.stringify(params.value))"
          }
        }
      },
      {
        "uuid": "extract",
        "serviceId": "text-generation",
        "serviceName": "Extract Offer",
        "state": {
          "backend": "server",
          "serverUrl": "https://inference.hetzner.com/api/v1",
          "model": "Qwen/Qwen3.6-35B-A3B-FP8",
          "systemPrompt": "Extract the booking request from this enquiry. Leave a field out when the message does not state it — never guess.",
          "thinking": false,
          "maxTokens": 4096,
          "jsonSchema": {
            "type": "object",
            "properties": {
              "hotel": {
                "type": "string"
              },
              "rooms": {
                "type": "integer"
              },
              "roomType": {
                "type": "string"
              },
              "arrival": {
                "type": "string",
                "description": "ISO date"
              },
              "departure": {
                "type": "string",
                "description": "ISO date"
              },
              "breakfastIncluded": {
                "type": "boolean"
              },
              "specialRequests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "hotel",
              "rooms"
            ]
          }
        }
      },
      {
        "uuid": "result",
        "serviceId": "monitor",
        "serviceName": "Extracted",
        "state": {
          "logToBoard": true
        }
      },
      {
        "uuid": "settle",
        "serviceId": "store",
        "serviceName": "Acknowledge",
        "state": {
          "mode": "ack"
        }
      },
      {
        "uuid": "after-settle",
        "serviceId": "stopper",
        "serviceName": "Done — Nothing Else Runs"
      }
    ],
    "requeue": [
      {
        "uuid": "return",
        "serviceId": "store",
        "serviceName": "Return To Queue",
        "state": {
          "mode": "requeue"
        }
      }
    ]
  },
  "facade": {
    "layout": "single",
    "panels": [
      {
        "id": "approval",
        "title": "Enquiries waiting",
        "layout": {
          "direction": "column",
          "items": [
            {
              "type": "data-table",
              "source": {
                "serviceUuid": "queue",
                "path": "records"
              },
              "selectable": true,
              "rowKey": "key",
              "selectionState": "picked",
              "columns": [
                "state",
                "key",
                "value.from",
                "value.subject",
                "createdAt"
              ],
              "pageSize": 10
            },
            {
              "direction": "row",
              "items": [
                {
                  "type": "button",
                  "label": "Process selected",
                  "actions": [
                    {
                      "type": "process",
                      "serviceUuid": "approved",
                      "payload": {
                        "keys": {
                          "$state": "picked"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "Return to queue",
                  "actions": [
                    {
                      "type": "process",
                      "serviceUuid": "return",
                      "payload": {
                        "keys": {
                          "$state": "picked"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "status-indicator",
                  "source": {
                    "serviceUuid": "extract",
                    "path": "status"
                  },
                  "statusColors": {
                    "idle": "#22c55e",
                    "generating": "#eab308",
                    "error": "#ef4444"
                  }
                },
                {
                  "type": "text",
                  "source": {
                    "serviceUuid": "extract",
                    "path": "error"
                  },
                  "tone": "error",
                  "placeholder": "Ready"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
