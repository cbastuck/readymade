{
  "compilerOptions": {
    "composite": true,
    // A referenced project has to emit, so it emits out of the way. Emitting
    // beside the sources put a vite.config.js next to vite.config.ts, which
    // vite loads first — edits to the .ts were then silently ignored.
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts", "vite-plugins/**/*.ts"]
}
