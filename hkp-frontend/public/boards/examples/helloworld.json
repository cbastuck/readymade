{
  "ExampleRuntime": {
    "type": "browser",
    "services": [
      {
        "serviceName": "Timer",
        "serviceId": "hookup.to/service/timer",
        "periodic": true,
        "start": true
      },
      {
        "serviceName": "Map",
        "serviceId": "hookup.to/service/map",
        "template": {
          "type": "text",
          "y": "45%",
          "textTransform": "uppercase-spacing-1",
          "font": {
            "weight": "lighter",
            "size": "90%",
            "family": "Helvetica Neue, sans-serif"
          },
          "color": "gray",
          "text=": "\"Hello World #\" + params.triggerCount"
        }
      },
      {
        "serviceName": "Canvas",
        "serviceId": "hookup.to/service/canvas",
        "fullscreen": false,
        "size": [400, 250],
        "resizable": false
      }
    ]
  }
}
