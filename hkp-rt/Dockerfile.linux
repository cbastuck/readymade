FROM ubuntu:latest

RUN apt-get update && apt-get install -y cmake libboost-all-dev g++ wget

WORKDIR /root
RUN wget https://github.com/MarkusJx/prebuilt-boost/releases/download/1.86.0/boost-1.86.0-ubuntu-20.04-gcc-static%2Bshared-x86.tar.gz
RUN tar -xvf boost-1.86.0-ubuntu-20.04-gcc-static+shared-x86.tar.gz

WORKDIR /hkp
COPY . .

WORKDIR /build
RUN BOOST_ROOT=/root/boost cmake /hkp
RUN make
